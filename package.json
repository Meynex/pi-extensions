{
  "name": "pi-extensions",
  "version": "0.1.0",
  "description": "A collection of TUI extensions for the pi coding agent: nicer tool-block rendering, context telemetry, goal/plan tracking, background jobs, and more.",
  "keywords": [
    "pi-package"
  ],
  "private": true,
  "license": "MIT",
  "pi": {
    "extensions": [
      "./extensions/accent-color",
      "./extensions/auto-compact-continue",
      "./extensions/auto-session-title",
      "./extensions/background-jobs",
      "./extensions/better-native-pi",
      "./extensions/cached-line-resets",
      "./extensions/code-blocks",
      "./extensions/context-inspector",
      "./extensions/doctor",
      "./extensions/edit-summary",
      "./extensions/footer",
      "./extensions/goal",
      "./extensions/herdr-process",
      "./extensions/herdr-tab-title",
      "./extensions/history-search",
      "./extensions/hyperlinks",
      "./extensions/image-store",
      "./extensions/koliko",
      "./extensions/model-switch-affinity",
      "./extensions/notifications",
      "./extensions/openai-codex-fast",
      "./extensions/overlay-stack",
      "./extensions/petit-chat-input-bar",
      "./extensions/plan-progress",
      "./extensions/prevent-sleep",
      "./extensions/questions",
      "./extensions/reload-all",
      "./extensions/rename",
      "./extensions/rewind",
      "./extensions/session-search",
      "./extensions/side-chat",
      "./extensions/subagents",
      "./extensions/telegram",
      "./extensions/transcript",
      "./extensions/turn-separator",
      "./extensions/turn-stats",
      "./extensions/working-timer"
    ]
  },
  "dependencies": {
    "@shikijs/core": "4.4.3",
    "@shikijs/engine-javascript": "4.4.3",
    "@shikijs/langs": "4.4.3",
    "marked": "18.0.5"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "^0.84.0",
    "@earendil-works/pi-ai": "^0.84.0",
    "@earendil-works/pi-coding-agent": "^0.84.0",
    "@earendil-works/pi-tui": "^0.84.0",
    "typebox": "1.3.7"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  }
}
